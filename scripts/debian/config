set -e

. /usr/share/debconf/confmodule

db_version 2.0 || true
db_capb backup || true

# Answers already given are remembered by debconf and not asked again on
# upgrade. Preseeded installers skip the matching question here; postinst
# then reads the preseeded value with db_get.
if [ -z "${FALCO_DRIVER_CHOICE:-}" ] && [ "${FALCO_FRONTEND:-}" != "noninteractive" ]; then
	db_input medium falco/driver-choice || true
fi
if [ -z "${FALCOCTL_ENABLED:-}" ] && [ "${FALCO_FRONTEND:-}" != "noninteractive" ]; then
	db_input medium falco/follow-rulesets || true
fi
db_go || true
