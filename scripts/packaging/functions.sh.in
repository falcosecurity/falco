# Shared at configure time: removal hooks must work after the payload is gone.
package_state=/var/lib/falco/package
follower_mask=/etc/systemd/system/falcoctl-artifact-follow.service

package_save_previous_driver() {
    mkdir -p "$package_state"
    rm -f "$package_state/previous-default" "$package_state/previous-version" "$package_state/pending-driver"
    # Configuration may enable JSON output, or refer to unavailable plugins.
    previous_default=$(falco -c /dev/null -o json_output=false --version 2>/dev/null | sed -n 's/^[[:space:]]*Default driver:[[:space:]]*//p')
    printf '%s\n' "$previous_default" > "$package_state/previous-default"
    # printenv creates a missing config, so do not call it on a fresh install.
    if [ -f /etc/falcoctl/falcoctl.yaml ]; then
        previous_env=$(falcoctl driver printenv 2>/dev/null) || previous_env=
        printf '%s\n' "$previous_env" | sed -n 's/^DRIVER_VERSION="\([^"]*\)"$/\1/p' > "$package_state/previous-version"
    fi
}

package_driver_version() {
    driver_env=$(falcoctl driver printenv)
    driver_version=$(printf '%s\n' "$driver_env" | sed -n 's/^DRIVER_VERSION="\([^"]*\)"$/\1/p')
    # RPM replaces the old configuration before %post; retain its driver pin.
    if [ "${package_format:-}" = rpm ] && [ -s "$package_state/previous-version" ]; then
        driver_version=$(cat "$package_state/previous-version")
    fi
    previous_default=
    if [ -f "$package_state/previous-default" ]; then
        previous_default=$(cat "$package_state/previous-default")
    fi
    if [ -n "${FALCOCTL_DRIVER_VERSION:-}" ]; then
        driver_version=$FALCOCTL_DRIVER_VERSION
    elif [ -z "$driver_version" ] || { [ -n "$previous_default" ] && [ "$driver_version" = "$previous_default" ]; }; then
        echo "[POST-INSTALL] Update package driver version to @DRIVER_VERSION@:"
        driver_version='@DRIVER_VERSION@'
    fi
}

package_install_kmod() {
    # The package unit uses modprobe, so an artifact in ~/.falco is insufficient.
    echo "[POST-INSTALL] Install kmod '$driver_version' for $(uname -r):"
    falcoctl driver install --version "$driver_version" --download=false
    # Older falcoctl releases can return success from the artifact cache after
    # removing DKMS. Repair that case until the bundled falcoctl is updated.
    if [ "$(modinfo -k "$(uname -r)" -F version falco 2>/dev/null)" != "$driver_version" ]; then
        dkms install -m falco -v "$driver_version" -k "$(uname -r)"
    fi
    if [ "$(modinfo -k "$(uname -r)" -F version falco 2>/dev/null)" != "$driver_version" ]; then
        echo "[POST-INSTALL] The installed falco module does not match '$driver_version'." >&2
        return 1
    fi
}

package_unmask_follower() {
    if [ -f "$package_state/follower-mask" ]; then
        if [ "$(readlink "$follower_mask")" = /dev/null ]; then
            systemctl --system unmask falcoctl-artifact-follow.service || return 1
        fi
        rm -f "$package_state/follower-mask"
    fi
}

package_mask_follower() {
    # An existing administrator mask has no package ownership marker.
    if [ "$(readlink "$follower_mask")" != /dev/null ]; then
        if systemctl --system mask falcoctl-artifact-follow.service; then
            if [ "$(readlink "$follower_mask")" = /dev/null ]; then
                mkdir -p "$package_state"
                touch "$package_state/follower-mask"
            fi
        fi
    fi
}

package_clear_transaction() {
    rm -f "$package_state/previous-default" "$package_state/previous-version" "$package_state/pending-driver"
    rmdir "$package_state" 2>/dev/null || true
    rmdir /var/lib/falco 2>/dev/null || true
}

package_remove_state() {
    package_unmask_follower || true
    # Repair aliases left by older Debian postrm scripts. Do not remove custom
    # aliases, administrator masks, or links to units that still exist.
    if [ -L /etc/systemd/system/falco.service ] && [ ! -e /etc/systemd/system/falco.service ]; then
        case "$(readlink /etc/systemd/system/falco.service)" in
            /lib/systemd/system/falco-kmod.service|/usr/lib/systemd/system/falco-kmod.service|\
            /lib/systemd/system/falco-modern-bpf.service|/usr/lib/systemd/system/falco-modern-bpf.service|\
            /lib/systemd/system/falco-custom.service|/usr/lib/systemd/system/falco-custom.service)
                rm -f /etc/systemd/system/falco.service
                ;;
        esac
    fi
    package_clear_transaction
}
