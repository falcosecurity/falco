set -e

@FALCO_PACKAGE_FUNCTIONS@

[ -f "$package_state/pending-driver" ] || exit 0
chosen_driver=$(sed -n '1p' "$package_state/pending-driver")
driver_version=$(sed -n '2p' "$package_state/pending-driver")
chosen_unit=
case "$chosen_driver" in
    kmod)
        package_install_kmod
        chosen_unit=kmod
        ;;
    modern_ebpf)
        chosen_unit=modern-bpf
        ;;
    none)
        ;;
    *)
        echo "[POST-TRANSACTION] Invalid pending driver: $chosen_driver" >&2
        exit 1
        ;;
esac
systemctl --system daemon-reload || true
if [ -n "$chosen_unit" ]; then
    # RPM expands this macro while building the package.
    %systemd_post "falco-$chosen_unit.service"
    systemctl --system enable "falco-$chosen_unit.service" || true
    systemctl --system start "falco-$chosen_unit.service" || true
fi
package_clear_transaction
